		}
	}

	Node head;

	void insertFirst(int data) {
		Node newNode = new Node(data);
		newNode.next = head;
		head = newNode;
	}

	void insertLast(int data) {
		Node newNode = new Node(data);
		if(head == null) {
			head = newNode;
			return;
		}

		Node temp = head;
		while(temp.next != null) {
			temp = temp.next;
		}
		temp.next = newNode;
	}

	void reverse() {
		Node prev = null;
		Node current = head;

		while(current != null) {
			Node newNode = current.next;

			current.next = prev;
			prev = current;
			current = newNode;
		}
		head = prev;
	}

