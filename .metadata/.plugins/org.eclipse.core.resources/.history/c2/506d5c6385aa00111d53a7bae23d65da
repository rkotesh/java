package Demo;

public class Binary_search {

	
    public static void main(String[] args) {
        int[] arr = {10, 20, 30, 40, 50, 60, 70, 80};
        int target = 60;
        
        int left = 0;
        int right = arr.length - 1;
        while ( left <= right) {
        	int mid = left + (right - left ) / 2;
        	
        	if (arr[mid] == target) {
        		System.out.println(mid);
        		break;
        	}
        	
        	if (arr[mid] < target) {
        		left = mid + 1;
        		System.out.println("Element is left" + left);
        	}
        	else {
        		right = mid - 1;
        		System.out.println("Element is " + right);
        	}
        }
        

 
    }
}
