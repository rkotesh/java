package Demo;

public class Hello {
	public static void main(String[] args) {
		
		// create and access an array -> time complexity O(1)
		int [] arr = {1, 2, 4, 5};
		int value = arr[2];
		System.out.println(value);
		
		//quadratic time
		int n = 5;
		for(int i = 0; i < n; i++) {
			for(int j = 0; j < n; j++) {
				System.out.println(i + "  " + j);
			}
		}
	}
}
