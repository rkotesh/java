package Demo;

public class Recursive_binary {
	    public static int binarySearch(int[] arr, int target, int left, int right) {
	        if (left > right) {
	            return -1;
	        }

	        int mid = left + (right - left) / 2;

	        if (arr[mid] == target) {
	            return mid;
	        }

	        if (arr[mid] > target) {
	            return binarySearch(arr, target, left, mid - 1);
	        }

	        return binarySearch(arr, target, mid + 1, right);
	    }

	    public static void main(String[] args) {
	        // The array must be sorted for binary search to work
	        int[] sortedArray = {3, 9, 15, 20, 24, 31, 45, 58, 62, 77, 88, 99};
	        
	        // Define the target value to search for
	        int target = 45;
	        
	        // Call the recursive search method directly inside the main method
	        int result = binarySearch(sortedArray, target, 0, sortedArray.length - 1);

	        // Print the search results
	        if (result == -1) {
	            System.out.println("Target " + target + " was not found in the array.");
	        } else {
	            System.out.println("Target " + target + " found at index: " + result);
	        }
	    }
	}

}
