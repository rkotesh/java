package Demo;

public class Delete_Node {
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    Node head = null;

    // FIX: Corrected insertion logic
    void insertAtBeginning(int data) {
        Node newNode = new Node(data);
        newNode.next = head;
        head = newNode;
    }

    void display() {
        Node current = head;
        while (current != null) {
            System.out.print(current.data + " -> ");
            current = current.next;
        }
        System.out.println("null");
    }

    // FIX: Corrected syntax errors, typos, and head-deletion logic
    void delete(int value) {
        if (head == null) {
            return;
        }

        // Case 1: The node to delete is the head node
        if (head.data == value) {
            head = head.next;
            return;
        }

        // Case 2: The node to delete is deeper in the list
        Node current = head;
        while (current.next != null && current.next.data != value) {
            current = current.next;
        }

        // If we found the node, bypass it
        if (current.next != null) {
            current.next = current.next.next;
        }
    }

    public static void main(String[] args) {
        // FIX: Instantiate the correct class name
        Delete_Node list = new Delete_Node(); 
        
        // Insert elements
        list.insertAtBeginning(30);
        list.insertAtBeginning(20);
        list.insertAtBeginning(10);
        list.insertAtBeginning(5);
        
        System.out.print("Original List: ");
        list.display();

        // Test deletion
        System.out.print("After deleting 20: ");
        list.delete(20);
        list.display();
    }
}
