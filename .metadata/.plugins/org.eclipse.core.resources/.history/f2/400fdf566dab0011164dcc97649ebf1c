package Demo;

public class Occurance {
	static int firstOccurance(int[] arr, int target) {
		int left = 0;
		int right = arr.length - 1;

		int answer = - 1;

		while (left <= right) {
			int mid = left + (right - left) / 2;
			if(arr[mid] == target) {
				answer = mid;
				right = mid - 1;
			}
			else if (arr[mid] < target) {
				left = mid + 1;
			}
			else { 
				right = mid - 1;
			}

		}
		return answer;	
	}

	static int lastOccurance(int[] arr, int target) {
