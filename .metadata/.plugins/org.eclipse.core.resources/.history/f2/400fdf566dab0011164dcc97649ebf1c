		while (left <= right) {
			int mid = left + (right - left) / 2;
			if(arr[mid] == target) {
				answer = mid;
				right = mid + 1;
			}
			else if (arr[mid] < target) {
				left = mid + 1;
			}
			else { 
				right = mid - 1;
			}

		}
		return answer;	
	}

