package Demo;

public class NthNodeFromEnd {
    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    Node head;

    int findNthFromEnd(int n) {
        // Edge Case: Handle empty list or invalid 'n' inputs
        if (head == null || n <= 0) {
            throw new IllegalArgumentException("List is empty or invalid value of n");
        }

        Node first = head;
        Node second = head;

        // Move 'first' pointer n steps ahead
        for (int i = 0; i < n; i++) {
            if (first == null) {
                throw new IllegalArgumentException("n is larger than the length of the linked list");
            }
            first = first.next;
        }

        // Move both pointers until 'first' reaches the end
        while (first != null) {
            first = first.next;
            second = second.next;
        }

        return second.data;
    }

    public static void main(String[] args) {
        NthNodeFromEnd list = new NthNodeFromEnd();

        
    }
}
